//スクロール量の調整(デフォルト150)
#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>

/ {
	behaviors {
		//エンコーダにスクロールを割り当てるためのビヘイビア
		msc_ec_l: sensor_rotation_scroll_L {
	        compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
			tap-ms = <20>;
        };
		msc_ec_r: sensor_rotation_scroll_R {
	        compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
			tap-ms = <20>;
        };
	};
};

//スクロールの調整
&msc {
    time-to-max-speed-ms = <0>;   // 即座に最大速度（加速なし）
    acceleration-exponent = <0>;   // 加速なし
};
/{
    combos {
        compatible = "zmk,combos";
        prioritize-longer-keys;
		//左クリックのコンボ 19 J 20 K
	    combo_LCLK {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&mkp LCLK>;
        };

		//右クリックのコンボ 20 K 21 L
        combo_RCLK {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&mkp RCLK>;
        };

		//ホイールクリックのコンボ 19 J 21 L
	    combo_MCLK {
            timeout-ms = <90>;
            key-positions = <19 21>;
            bindings = <&mkp MCLK>;
        };

		//作ったけど消した。ポインティングデバイスをスクロールにしたい人向け
		//31 M 32 ,
		combo_SCROLL {
            timeout-ms = <50>;
            key-positions = <31 32>;
            bindings = <&mo 4>;
        };
    };
};

/{
keymap {
        compatible = "zmk,keymap";

        // -----------------------------------------------------------------------------------------
        // LAYER 0: Default Layer (最下段カスタム仕様)
        // -----------------------------------------------------------------------------------------
        default_layer {
            bindings = <
    &kp TAB    &kp Q   &kp W  &kp E  &kp R  &kp T       &kp Y  &kp U  &kp I      &kp O    &kp P     &kp BSPC
    &kp LCTRL  &kp A   &kp S  &kp D  &kp F  &kp G       &kp H  &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
    &kp LSHFT  &kp Z   &kp X  &kp C  &kp V  &kp B       &kp N  &kp M  &kp COMMA  &kp DOT  &kp SLASH &kp RSHFT
    &trans     &trans         &lt 1 LANG2   &mt LGUI SPACE   &mt RALT RET  &lt 2 LANG1         &kp PSCRN &mo 3
            >;
            // トラックボール/パッドによるスクロールバインディング
            sensor-bindings = <&msc_ec_l SCRL_LEFT SCRL_RIGHT &msc_ec_r SCRL_UP SCRL_DOWN>;
        };

        // -----------------------------------------------------------------------------------------
        // LAYER 1: Lower (Keyball44風 数字・ナビゲーション・マウスボタン)
        // -----------------------------------------------------------------------------------------
        layer_1 {
            bindings = <
    &kp ESC    &kp N1  &kp N2  &kp N3  &kp N4  &kp N5      &kp N6   &kp N7    &kp N8   &kp N9    &kp N0  &kp BSPC
    &kp LCTRL  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5      &kp F6   &mkp LCLK &kp UP   &mkp RCLK &trans  &trans
    &kp LSHFT  &kp F7  &kp F8  &kp F9  &kp F10 &kp F11     &kp F12  &kp LEFT  &kp DOWN &kp RIGHT &trans  &trans
    &trans     &trans                   &trans  &trans      &trans   &trans                        &trans  &trans
            >;
        };

        // -----------------------------------------------------------------------------------------
        // LAYER 2: Raise (Keyball44画像から100%復元した記号レイヤー)
        // -----------------------------------------------------------------------------------------
        layer_2 {
            bindings = <
    &kp ESC    &kp EXCL &kp AT   &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
    &kp LCTRL  &trans   &trans   &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBRC  &kp RBRC &kp PIPE &kp TILDE
    &kp LSHFT  &trans   &trans   &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBKT  &kp RBKT &kp BSLH  &kp GRAVE
    &trans     &trans                     &trans   &trans      &trans    &trans                       &trans   &trans
            >;
        };

        // -----------------------------------------------------------------------------------------
        // LAYER 3: BT/System
        // -----------------------------------------------------------------------------------------
        layer_3 {
            bindings = <
    &trans &trans &trans &trans &trans &trans      &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3   &bt BT_SEL 4
    &trans &trans &trans &trans &trans &trans      &trans  &trans        &trans        &trans        &trans         &trans
    &trans &trans &trans &trans &trans &trans      &trans  &trans        &trans        &trans        &bt BT_CLR_ALL &bt BT_CLR
    &trans &trans                      &trans      &trans  &trans        &out OUT_BLE                               &trans &trans
            >;
        };
    };
};