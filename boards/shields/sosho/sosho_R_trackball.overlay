#include "sosho_R.dtsi"

&spi1 { status = "okay"; };
&trackball { status = "okay"; };
&trackball_listener {
	status = "okay";
	input-processors = <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>;

	scroll {
		layers = <1>;
		input-processors = <
			&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
			&zip_x_scaler 0 1          /* 横成分を捨てて縦専用化 */
			&zip_y_scaler 1 16         /* hi-res倍率(約200倍)を相殺するため強めに分周。速すぎ/遅すぎはここで調整 */
			&zip_xy_to_scroll_mapper
		>;
	};
};

/* 未使用の左側ポインティング受信を無効化して負荷を削減（elekit指示） */
&glidepoint_split { status = "disabled"; };
&glidepoint_split_listener {
    status = "disabled";
/* input-processors = <&zip_xy_scaler 2 1>; */
};

&trackball_split { status = "disabled"; };
&trackball_split_listener { status = "disabled"; };