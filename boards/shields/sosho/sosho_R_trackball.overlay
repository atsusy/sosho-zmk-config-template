#include "sosho_R.dtsi"

&spi1 { status = "okay"; };
&trackball { status = "okay"; };
&trackball_listener {
	status = "okay";
	input-processors = <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>;

	scroll {
		layers = <1>;
		input-processors = <
			&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
			&zip_x_scaler 0 1          /* 横成分を捨てて縦専用化（macOSの軸ロック回避＋Chromium連鎖対策） */
			/* 高解像度スクロール(SMOOTH_SCROLLING)有効時は1ティック=行の1/120なので、
			   従来の1/6分周だと遅すぎる。まず素通し(分周なし)で開始し、速すぎる場合だけ
			   ここに &zip_y_scaler 1 2 等を足して微調整する。 */
			&zip_xy_to_scroll_mapper
		>;
	};
};

/* 未使用の左側ポインティング受信を無効化して負荷を削減（elekit指示） */
&glidepoint_split { status = "disabled"; };
&glidepoint_split_listener {
    status = "disabled";
/* input-processors = <&zip_xy_scaler 2 1>; */
};

&trackball_split { status = "disabled"; };
&trackball_split_listener { status = "disabled"; };